static func by_id(id: String) -> Dictionary:
	for z in LIST:
		if z["id"] == id:
			return z
	return LIST[0]


## Zones whose range contains a level, the closest ones if none does.
static func for_level(level: int) -> Array:
	var out := []
	for z in LIST:
		if level >= z["min"] and level <= z["max"]:
			out.append(z)
	if out.is_empty():
		out.append(LIST[LIST.size() - 1])
	return out
